# Copy to .env and run with: node --env-file=.env server.js
PORT=3000
STORE_NAME=Nova & Nest
SUPPORT_EMAIL=support@example.com
# Public URL of the store (used for Stripe redirect URLs in production)
BASE_URL=http://localhost:3000
# Password for /admin.html (order fulfilment dashboard)
ADMIN_PASSWORD=change-me
# Leave blank to run in demo mode (orders auto-approved, no real payment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
