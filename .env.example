# Copy to .env and run with: node --env-file=.env server.js
PORT=3000
STORE_NAME=Nova & Nest
SUPPORT_EMAIL=support@example.com
# Public URL of the store (used for Stripe redirect URLs and links in emails)
BASE_URL=http://localhost:3000
# Password for /admin.html (order fulfilment dashboard)
ADMIN_PASSWORD=change-me
# Leave blank to run in demo mode (orders auto-approved, no real payment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Automation ----
# CJdropshipping API key (CJ → My CJ → Authorization → API). Paid orders are
# then created at CJ automatically, unpaid, for you to pay in CJ's dashboard.
CJ_API_KEY=
CJ_LOGISTIC_NAME=CJPacket Ordinary
# SMTP server for customer emails, e.g. smtps://user%40gmail.com:app-password@smtp.gmail.com:465
# (URL-encode @ and other special characters in the user name and password).
SMTP_URL=
# Sender shown on emails. Must be an address your SMTP account may send from.
EMAIL_FROM=Nova & Nest <orders@example.com>
# Where alerts and the daily summary go.
OWNER_EMAIL=
# How often automation runs inside the server, and the hour (0-23, server time) of the daily summary.
AUTOMATION_INTERVAL_MINUTES=10
DIGEST_HOUR=8
